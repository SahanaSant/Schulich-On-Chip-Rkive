CAPI=2:
name: local:schulich:udma_external_per:0.1.0
description: Focused external peripheral verification at subsystem widths
filesets:
  rtl:
    files:
      - dependencies/common_cells/src/onehot_to_bin.sv
      - dependencies/logint_dc_fifo_xbar/dc_data_buffer.sv
      - dependencies/logint_dc_fifo_xbar/dc_full_detector.v
      - dependencies/logint_dc_fifo_xbar/dc_synchronizer.v
      - dependencies/logint_dc_fifo_xbar/dc_token_ring.v
      - dependencies/logint_dc_fifo_xbar/dc_token_ring_fifo_din.v
      - dependencies/logint_dc_fifo_xbar/dc_token_ring_fifo_dout.v
      - udma_core/rtl/common/io_generic_fifo.sv
      - udma_core/rtl/common/io_tx_fifo.sv
      - udma_core/rtl/common/udma_dc_fifo.sv
      - udma_external_per/rtl/udma_external_per_reg_if.sv
      - udma_external_per/rtl/udma_external_per_top.sv
    file_type: systemVerilogSource
  tb:
    files:
      - tb/udma_external_per_top_tb.sv
    file_type: systemVerilogSource
targets:
  lint:
    default_tool: verilator
    filesets: [rtl]
    toplevel: udma_external_per_top
    tools:
      verilator:
        mode: lint-only
        verilator_options: ["-Wno-fatal", "-GL2_AWIDTH_NOAL=21", "-GTRANS_SIZE=20"]
  sim:
    default_tool: verilator
    filesets: [rtl, tb]
    toplevel: udma_external_per_top_tb
    tools:
      verilator:
        mode: binary
        verilator_options: ["-Wno-fatal", "--timing", "--assert"]
